# Variables de entorno para la suite de tests
# NUNCA uses valores reales aquí — son solo para pruebas automatizadas

PORT=3001
NODE_ENV=test

# BD de test (crea 'juridico_test' con las migraciones antes de correr tests de integración)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=juridico_test

# JWT — string largo de prueba
JWT_SECRET=juridico-test-secret-key-only-for-automated-tests-not-production
JWT_EXPIRES_IN=1h

# AES-256 requiere exactamente 32 bytes
ENCRYPTION_KEY=juridico_test_key_32bytes_12345_
