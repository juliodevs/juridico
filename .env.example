# =============================================================
# .env.example — Plantilla pública de variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.
# =============================================================

# ── Servidor ──────────────────────────────────────────────────
PORT=3000

# ── Base de datos (infraestructura — solo en .env) ────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=juridico

# Pool de conexiones
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ── Autenticación JWT ─────────────────────────────────────────
# Genera un valor aleatorio de mínimo 32 caracteres
# En Linux/Mac: openssl rand -base64 32
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# ── Cifrado de configuración sensible en BD ───────────────────
# Exactamente 32 caracteres para AES-256
# En Linux/Mac: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY=cambia_esto_por_32_caracteres_ok

# ── Seed de admin inicial ─────────────────────────────────────
# Solo se usa al ejecutar: npm run seed:admin
ADMIN_EMAIL=admin@tudespacho.com
ADMIN_PASSWORD=cambia_esto_por_password_seguro
ADMIN_NOMBRE=Administrador

# ── Entorno ───────────────────────────────────────────────────
NODE_ENV=development
# En producción: NODE_ENV=production

# =============================================================
# NOTA: La configuración de SMTP, WhatsApp, alertas y datos
# del despacho se administra desde el Panel de Administración
# en la UI y se almacena cifrada en la tabla `configuracion`.
# NO van aquí.
# =============================================================
